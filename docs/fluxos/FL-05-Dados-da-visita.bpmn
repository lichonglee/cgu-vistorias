  <bpmn:process id="Process_1" name="FL-05 · Preencher os dados da visita" isExecutable="false">
    <bpmn:documentation>Contexto da inspeção: local, tipo, data e hora, participantes, GPS, clima, objetivo, metodologia e documentos.&#10;Curso: Controladoria-Geral da União · Disciplina: CGU Vistorias v1.0.5 · Autores: Responsável: Eng. DSc Li Chong Lee Bacelar de Castro · Revisão: R01</bpmn:documentation>
    <bpmn:startEvent id="N_n1" name="Aba Dados aberta"><bpmn:outgoing>F_e11</bpmn:outgoing></bpmn:startEvent>
    <bpmn:task id="N_n2" name="Informar local visitado, tipo de vistoria, data, hora e participantes" ipog:responsavel="Usuário"><bpmn:documentation>Responsável: Usuário</bpmn:documentation><bpmn:incoming>F_e11</bpmn:incoming><bpmn:outgoing>F_e12</bpmn:outgoing></bpmn:task>
    <bpmn:task id="N_n3" name="Conferir a data e o relógio do aparelho" ipog:responsavel="Usuário"><bpmn:documentation>Responsável: Usuário</bpmn:documentation><bpmn:incoming>F_e12</bpmn:incoming><bpmn:outgoing>F_e13</bpmn:outgoing></bpmn:task>
    <bpmn:exclusiveGateway id="N_n4" name="Registrar localização?"><bpmn:incoming>F_e13</bpmn:incoming><bpmn:outgoing>F_e14</bpmn:outgoing><bpmn:outgoing>F_e15</bpmn:outgoing></bpmn:exclusiveGateway>
    <bpmn:task id="N_n5" name="Tocar em Usar minha localização e aguardar o GPS" ipog:software="GPS" ipog:responsavel="Usuário"><bpmn:documentation>Responsável: Usuário&#10;Software / ferramenta: GPS</bpmn:documentation><bpmn:incoming>F_e14</bpmn:incoming><bpmn:outgoing>F_e16</bpmn:outgoing></bpmn:task>
    <bpmn:exclusiveGateway id="N_n6" name="GPS respondeu?"><bpmn:incoming>F_e16</bpmn:incoming><bpmn:outgoing>F_e17</bpmn:outgoing><bpmn:outgoing>F_e18</bpmn:outgoing></bpmn:exclusiveGateway>
    <bpmn:task id="N_n7" name="Conferir coordenadas e precisão" ipog:responsavel="Usuário"><bpmn:documentation>Responsável: Usuário</bpmn:documentation><bpmn:incoming>F_e17</bpmn:incoming><bpmn:outgoing>F_e19</bpmn:outgoing></bpmn:task>
    <bpmn:task id="N_n8" name="Descrever o local de forma clara, sem coordenadas" ipog:responsavel="Usuário"><bpmn:documentation>Responsável: Usuário</bpmn:documentation><bpmn:incoming>F_e18</bpmn:incoming><bpmn:outgoing>F_e20</bpmn:outgoing></bpmn:task>
    <bpmn:task id="N_n9" name="Informar clima, objetivo, metodologia e documentos consultados" ipog:responsavel="Usuário"><bpmn:documentation>Responsável: Usuário</bpmn:documentation><bpmn:incoming>F_e15</bpmn:incoming><bpmn:incoming>F_e19</bpmn:incoming><bpmn:incoming>F_e20</bpmn:incoming><bpmn:outgoing>F_e21</bpmn:outgoing></bpmn:task>
    <bpmn:endEvent id="N_n10" name="Dados salvos automaticamente"><bpmn:incoming>F_e21</bpmn:incoming></bpmn:endEvent>
