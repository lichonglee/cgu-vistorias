    <bpmndi:BPMNEdge id="F_e8_di" bpmnElement="F_e8"><di:waypoint x="390" y="210"/><di:waypoint x="390" y="172"/><di:waypoint x="624" y="172"/><di:waypoint x="624" y="134"/></bpmndi:BPMNEdge>
