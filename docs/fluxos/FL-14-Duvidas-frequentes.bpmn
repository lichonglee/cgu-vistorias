    <bpmndi:BPMNEdge id="F_e13_di" bpmnElement="F_e13"><di:waypoint x="676" y="346"/><di:waypoint x="676" y="303"/><di:waypoint x="910" y="303"/><di:waypoint x="910" y="260"/></bpmndi:BPMNEdge>
