    <bpmn:sequenceFlow id="F_e12" name="Não" sourceRef="N_n4" targetRef="N_n7"/>
    <bpmn:sequenceFlow id="F_e13" name="" sourceRef="N_n5" targetRef="N_n6"/>
    <bpmn:sequenceFlow id="F_e14" name="" sourceRef="N_n6" targetRef="N_n7"/>
  </bpmn:process>
