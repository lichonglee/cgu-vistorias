<?xml version="1.0" encoding="UTF-8"?>
<bpmn:definitions xmlns:bioc="http://bpmn.io/schema/bpmn/biocolor/1.0" xmlns:color="http://www.omg.org/spec/BPMN/non-normative/color/1.0" xmlns:bpmn="http://www.omg.org/spec/BPMN/20100524/MODEL" xmlns:bpmndi="http://www.omg.org/spec/BPMN/20100524/DI" xmlns:dc="http://www.omg.org/spec/DD/20100524/DC" xmlns:ipog="http://ipog.edu.br/schema" xmlns:di="http://www.omg.org/spec/DD/20100524/DI" id="Definitions_1" targetNamespace="http://ipog.edu.br/bpmn" exporter="IPOG Fluxos de Trabalho BIM" exporterVersion="2.0">
  <bpmn:process id="Process_1" name="FL-19 · Gerir edifícios e vínculos" isExecutable="false">
    <bpmn:documentation>Criação do edifício central, vínculo de pessoas e mapeamento dos edifícios locais por pedido de vínculo.&#10;Curso: Controladoria-Geral da União · Disciplina: CGU Vistorias v1.0.5 · Autores: Responsável: Eng. DSc Li Chong Lee Bacelar de Castro · Revisão: R01</bpmn:documentation>
    <bpmn:startEvent id="N_n1" name="Edifício a administrar"><bpmn:outgoing>F_e8</bpmn:outgoing></bpmn:startEvent>
    <bpmn:task id="N_n2" name="Criar o edifício (cliente, endereço, contrato, ART)" ipog:responsavel="Administrador"><bpmn:documentation>Responsável: Administrador</bpmn:documentation><bpmn:incoming>F_e8</bpmn:incoming><bpmn:outgoing>F_e9</bpmn:outgoing></bpmn:task>
    <bpmn:task id="N_n3" name="Vincular pessoas ao edifício" ipog:responsavel="Administrador"><bpmn:documentation>Responsável: Administrador</bpmn:documentation><bpmn:incoming>F_e9</bpmn:incoming><bpmn:outgoing>F_e10</bpmn:outgoing></bpmn:task>
    <bpmn:exclusiveGateway id="N_n4" name="Há pedido de vínculo local?"><bpmn:incoming>F_e10</bpmn:incoming><bpmn:outgoing>F_e11</bpmn:outgoing><bpmn:outgoing>F_e12</bpmn:outgoing></bpmn:exclusiveGateway>
    <bpmn:task id="N_n5" name="Pedir vínculo do edifício local ao central" ipog:responsavel="Vistoriador"><bpmn:documentation>Responsável: Vistoriador</bpmn:documentation><bpmn:incoming>F_e11</bpmn:incoming><bpmn:outgoing>F_e13</bpmn:outgoing></bpmn:task>
    <bpmn:task id="N_n6" name="Aprovar o mapeamento local → central" ipog:responsavel="Administrador"><bpmn:documentation>Responsável: Administrador</bpmn:documentation><bpmn:incoming>F_e13</bpmn:incoming><bpmn:outgoing>F_e14</bpmn:outgoing></bpmn:task>
    <bpmn:endEvent id="N_n7" name="Edifício mapeado"><bpmn:incoming>F_e12</bpmn:incoming><bpmn:incoming>F_e14</bpmn:incoming></bpmn:endEvent>
    <bpmn:sequenceFlow id="F_e8" name="" sourceRef="N_n1" targetRef="N_n2"/>
    <bpmn:sequenceFlow id="F_e9" name="" sourceRef="N_n2" targetRef="N_n3"/>
    <bpmn:sequenceFlow id="F_e10" name="" sourceRef="N_n3" targetRef="N_n4"/>
