<?xml version="1.0" encoding="UTF-8"?>
<bpmn:definitions xmlns:bioc="http://bpmn.io/schema/bpmn/biocolor/1.0" xmlns:color="http://www.omg.org/spec/BPMN/non-normative/color/1.0" xmlns:bpmn="http://www.omg.org/spec/BPMN/20100524/MODEL" xmlns:bpmndi="http://www.omg.org/spec/BPMN/20100524/DI" xmlns:dc="http://www.omg.org/spec/DD/20100524/DC" xmlns:ipog="http://ipog.edu.br/schema" xmlns:di="http://www.omg.org/spec/DD/20100524/DI" id="Definitions_1" targetNamespace="http://ipog.edu.br/bpmn" exporter="IPOG Fluxos de Trabalho BIM" exporterVersion="2.0">
  <bpmn:process id="Process_1" name="FL-16 · Sincronizar, arquivar e restaurar" isExecutable="false">
    <bpmn:documentation>Envio de snapshots, relatórios, fotos e ações à Central, confirmação do arquivamento e restauração por páginas.&#10;Curso: Controladoria-Geral da União · Disciplina: CGU Vistorias v1.0.5 · Autores: Responsável: Eng. DSc Li Chong Lee Bacelar de Castro · Revisão: R01</bpmn:documentation>
    <bpmn:startEvent id="N_n1" name="Registros locais"><bpmn:outgoing>F_e11</bpmn:outgoing></bpmn:startEvent>
    <bpmn:task id="N_n2" name="Trabalhar offline (até 30 dias) e conectar" ipog:responsavel="Vistoriador"><bpmn:documentation>Responsável: Vistoriador</bpmn:documentation><bpmn:incoming>F_e11</bpmn:incoming><bpmn:outgoing>F_e12</bpmn:outgoing></bpmn:task>
    <bpmn:task id="N_n3" name="Enviar snapshots, relatórios, fotos e ações" ipog:responsavel="Aplicativo"><bpmn:documentation>Responsável: Aplicativo</bpmn:documentation><bpmn:incoming>F_e12</bpmn:incoming><bpmn:outgoing>F_e13</bpmn:outgoing></bpmn:task>
    <bpmn:exclusiveGateway id="N_n4" name="Há cota de armazenamento?"><bpmn:incoming>F_e13</bpmn:incoming><bpmn:outgoing>F_e14</bpmn:outgoing><bpmn:outgoing>F_e15</bpmn:outgoing></bpmn:exclusiveGateway>
    <bpmn:endEvent id="N_n5" name="Envio recusado"><bpmn:incoming>F_e15</bpmn:incoming></bpmn:endEvent>
    <bpmn:task id="N_n6" name="Arquivar e confirmar (cgu_confirm_archive)" ipog:responsavel="Central"><bpmn:documentation>Responsável: Central</bpmn:documentation><bpmn:incoming>F_e14</bpmn:incoming><bpmn:outgoing>F_e16</bpmn:outgoing></bpmn:task>
    <bpmn:task id="N_n7" name="Atualizar os dados do painel" ipog:software="ingest_cgu_snapshots" ipog:responsavel="Central"><bpmn:documentation>Responsável: Central&#10;Software / ferramenta: ingest_cgu_snapshots</bpmn:documentation><bpmn:incoming>F_e16</bpmn:incoming><bpmn:outgoing>F_e17</bpmn:outgoing></bpmn:task>
    <bpmn:exclusiveGateway id="N_n8" name="Restaurar no aparelho?"><bpmn:incoming>F_e17</bpmn:incoming><bpmn:outgoing>F_e18</bpmn:outgoing><bpmn:outgoing>F_e19</bpmn:outgoing></bpmn:exclusiveGateway>
    <bpmn:task id="N_n9" name="Restaurar por páginas (cgu_restore_page)" ipog:responsavel="Central"><bpmn:documentation>Responsável: Central</bpmn:documentation><bpmn:incoming>F_e18</bpmn:incoming><bpmn:outgoing>F_e20</bpmn:outgoing></bpmn:task>
    <bpmn:endEvent id="N_n10" name="Registros sincronizados"><bpmn:incoming>F_e19</bpmn:incoming><bpmn:incoming>F_e20</bpmn:incoming></bpmn:endEvent>
    <bpmn:sequenceFlow id="F_e11" name="" sourceRef="N_n1" targetRef="N_n2"/>
    <bpmn:sequenceFlow id="F_e12" name="" sourceRef="N_n2" targetRef="N_n3"/>
    <bpmn:sequenceFlow id="F_e13" name="" sourceRef="N_n3" targetRef="N_n4"/>
    <bpmn:sequenceFlow id="F_e14" name="Sim" sourceRef="N_n4" targetRef="N_n6"/>
    <bpmn:sequenceFlow id="F_e15" name="Não" sourceRef="N_n4" targetRef="N_n5"/>
    <bpmn:sequenceFlow id="F_e16" name="" sourceRef="N_n6" targetRef="N_n7"/>
    <bpmn:sequenceFlow id="F_e17" name="" sourceRef="N_n7" targetRef="N_n8"/>
    <bpmn:sequenceFlow id="F_e18" name="Sim" sourceRef="N_n8" targetRef="N_n9"/>
    <bpmn:sequenceFlow id="F_e19" name="Não" sourceRef="N_n8" targetRef="N_n10"/>
    <bpmn:sequenceFlow id="F_e20" name="" sourceRef="N_n9" targetRef="N_n10"/>
  </bpmn:process>
