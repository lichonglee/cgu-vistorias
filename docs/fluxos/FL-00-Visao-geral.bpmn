  <bpmn:process id="Process_1" name="FL-00 · Visão geral da vistoria" isExecutable="false">
    <bpmn:documentation>Da configuração do perfil ao backup: a jornada completa do vistoriador no aplicativo.&#10;Curso: Controladoria-Geral da União · Disciplina: CGU Vistorias v1.0.5 · Autores: Responsável: Eng. DSc Li Chong Lee Bacelar de Castro · Revisão: R01</bpmn:documentation>
    <bpmn:startEvent id="N_n1" name="Vistoria a realizar"><bpmn:outgoing>F_e13</bpmn:outgoing></bpmn:startEvent>
    <bpmn:task id="N_n2" name="Configurar o perfil em Ajustes" ipog:software="Ajustes" ipog:responsavel="Usuário"><bpmn:documentation>Responsável: Usuário&#10;Software / ferramenta: Ajustes</bpmn:documentation><bpmn:incoming>F_e13</bpmn:incoming><bpmn:outgoing>F_e14</bpmn:outgoing></bpmn:task>
    <bpmn:task id="N_n3" name="Cadastrar ou abrir o edifício" ipog:software="Edifícios" ipog:responsavel="Usuário"><bpmn:documentation>Responsável: Usuário&#10;Software / ferramenta: Edifícios</bpmn:documentation><bpmn:incoming>F_e14</bpmn:incoming><bpmn:outgoing>F_e15</bpmn:outgoing></bpmn:task>
    <bpmn:task id="N_n4" name="Criar a vistoria (rascunho)" ipog:software="Nova vistoria" ipog:responsavel="Usuário"><bpmn:documentation>Responsável: Usuário&#10;Software / ferramenta: Nova vistoria</bpmn:documentation><bpmn:incoming>F_e15</bpmn:incoming><bpmn:outgoing>F_e16</bpmn:outgoing></bpmn:task>
    <bpmn:task id="N_n5" name="Preencher os dados da visita" ipog:software="Dados" ipog:responsavel="Usuário"><bpmn:documentation>Responsável: Usuário&#10;Software / ferramenta: Dados</bpmn:documentation><bpmn:incoming>F_e16</bpmn:incoming><bpmn:outgoing>F_e17</bpmn:outgoing></bpmn:task>
    <bpmn:task id="N_n6" name="Fotografar e legendar as evidências" ipog:software="Fotos" ipog:responsavel="Usuário"><bpmn:documentation>Responsável: Usuário&#10;Software / ferramenta: Fotos</bpmn:documentation><bpmn:incoming>F_e17</bpmn:incoming><bpmn:outgoing>F_e18</bpmn:outgoing></bpmn:task>
    <bpmn:task id="N_n7" name="Registrar as constatações" ipog:software="Constatações" ipog:responsavel="Usuário"><bpmn:documentation>Responsável: Usuário&#10;Software / ferramenta: Constatações</bpmn:documentation><bpmn:incoming>F_e18</bpmn:incoming><bpmn:outgoing>F_e19</bpmn:outgoing></bpmn:task>
    <bpmn:task id="N_n8" name="Concluir o registro (parecer e recomendações)" ipog:software="Conclusão" ipog:responsavel="Usuário"><bpmn:documentation>Responsável: Usuário&#10;Software / ferramenta: Conclusão</bpmn:documentation><bpmn:incoming>F_e19</bpmn:incoming><bpmn:outgoing>F_e20</bpmn:outgoing></bpmn:task>
    <bpmn:task id="N_n9" name="Emitir Word ou PDF" ipog:software="Emitir" ipog:responsavel="Usuário"><bpmn:documentation>Responsável: Usuário&#10;Software / ferramenta: Emitir</bpmn:documentation><bpmn:incoming>F_e20</bpmn:incoming><bpmn:outgoing>F_e21</bpmn:outgoing></bpmn:task>
