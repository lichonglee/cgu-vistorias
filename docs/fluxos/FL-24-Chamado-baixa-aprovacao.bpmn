    <bpmn:sequenceFlow id="F_e12" name="" sourceRef="N_n4" targetRef="N_n5"/>
    <bpmn:sequenceFlow id="F_e13" name="Sim" sourceRef="N_n5" targetRef="N_n6"/>
    <bpmn:sequenceFlow id="F_e14" name="Não, refazer" sourceRef="N_n5" targetRef="N_n3"/>
    <bpmn:sequenceFlow id="F_e15" name="" sourceRef="N_n6" targetRef="N_n8"/>
    <bpmn:dataObject id="DO_n7"/>
    <bpmn:dataObjectReference id="N_n7" name="Anexo da baixa (JPG, PNG, WebP ou PDF)" dataObjectRef="DO_n7"/>
    <bpmn:association id="A_e16" name="" sourceRef="N_n3" targetRef="N_n7"/>
  </bpmn:process>
