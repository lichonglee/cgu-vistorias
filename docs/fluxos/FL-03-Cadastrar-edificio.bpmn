    <bpmn:sequenceFlow id="F_e20" name="Não" sourceRef="N_n8" targetRef="N_n10"/>
    <bpmn:sequenceFlow id="F_e21" name="" sourceRef="N_n9" targetRef="N_n10"/>
  </bpmn:process>
