<?xml version="1.0" encoding="UTF-8"?>
<bpmn:definitions xmlns:bioc="http://bpmn.io/schema/bpmn/biocolor/1.0" xmlns:color="http://www.omg.org/spec/BPMN/non-normative/color/1.0" xmlns:bpmn="http://www.omg.org/spec/BPMN/20100524/MODEL" xmlns:bpmndi="http://www.omg.org/spec/BPMN/20100524/DI" xmlns:dc="http://www.omg.org/spec/DD/20100524/DC" xmlns:ipog="http://ipog.edu.br/schema" xmlns:di="http://www.omg.org/spec/DD/20100524/DI" id="Definitions_1" targetNamespace="http://ipog.edu.br/bpmn" exporter="IPOG Fluxos de Trabalho BIM" exporterVersion="2.0">
  <bpmn:process id="Process_1" name="FL-17 · Gravar e enviar vídeo da constatação" isExecutable="false">
    <bpmn:documentation>Gravação de campo, legenda, envio ao repositório (limite de 50 MB) e consulta na tela Vídeos.&#10;Curso: Controladoria-Geral da União · Disciplina: CGU Vistorias v1.0.5 · Autores: Responsável: Eng. DSc Li Chong Lee Bacelar de Castro · Revisão: R01</bpmn:documentation>
    <bpmn:startEvent id="N_n1" name="Constatação aberta"><bpmn:outgoing>F_e10</bpmn:outgoing></bpmn:startEvent>
    <bpmn:task id="N_n2" name="Gravar o vídeo da constatação" ipog:software="Câmera" ipog:responsavel="Vistoriador"><bpmn:documentation>Responsável: Vistoriador&#10;Software / ferramenta: Câmera</bpmn:documentation><bpmn:incoming>F_e10</bpmn:incoming><bpmn:outgoing>F_e11</bpmn:outgoing></bpmn:task>
    <bpmn:task id="N_n3" name="Editar a legenda (rótulo) do vídeo" ipog:responsavel="Vistoriador"><bpmn:documentation>Responsável: Vistoriador</bpmn:documentation><bpmn:incoming>F_e11</bpmn:incoming><bpmn:outgoing>F_e12</bpmn:outgoing></bpmn:task>
    <bpmn:exclusiveGateway id="N_n4" name="Até 50 MB?"><bpmn:incoming>F_e12</bpmn:incoming><bpmn:outgoing>F_e13</bpmn:outgoing><bpmn:outgoing>F_e14</bpmn:outgoing></bpmn:exclusiveGateway>
    <bpmn:endEvent id="N_n5" name="Vídeo recusado"><bpmn:incoming>F_e14</bpmn:incoming></bpmn:endEvent>
    <bpmn:task id="N_n6" name="Enviar ao repositório (register_cgu_video)" ipog:software="unidade/videos" ipog:responsavel="Aplicativo"><bpmn:documentation>Responsável: Aplicativo&#10;Software / ferramenta: unidade/videos</bpmn:documentation><bpmn:incoming>F_e13</bpmn:incoming><bpmn:outgoing>F_e15</bpmn:outgoing></bpmn:task>
    <bpmn:task id="N_n7" name="Consultar na tela Vídeos da Central" ipog:responsavel="Gestor"><bpmn:documentation>Responsável: Gestor</bpmn:documentation><bpmn:incoming>F_e15</bpmn:incoming><bpmn:outgoing>F_e16</bpmn:outgoing><bpmn:outgoing>F_e17</bpmn:outgoing></bpmn:task>
    <bpmn:task id="N_n8" name="Apagar pelo Backup e limpeza (opcional)" ipog:responsavel="Administrador"><bpmn:documentation>Responsável: Administrador</bpmn:documentation><bpmn:incoming>F_e17</bpmn:incoming><bpmn:outgoing>F_e18</bpmn:outgoing></bpmn:task>
    <bpmn:endEvent id="N_n9" name="Vídeo disponível"><bpmn:incoming>F_e16</bpmn:incoming><bpmn:incoming>F_e18</bpmn:incoming></bpmn:endEvent>
    <bpmn:sequenceFlow id="F_e10" name="" sourceRef="N_n1" targetRef="N_n2"/>
    <bpmn:sequenceFlow id="F_e11" name="" sourceRef="N_n2" targetRef="N_n3"/>
    <bpmn:sequenceFlow id="F_e12" name="" sourceRef="N_n3" targetRef="N_n4"/>
    <bpmn:sequenceFlow id="F_e13" name="Sim" sourceRef="N_n4" targetRef="N_n6"/>
    <bpmn:sequenceFlow id="F_e14" name="Não" sourceRef="N_n4" targetRef="N_n5"/>
    <bpmn:sequenceFlow id="F_e15" name="" sourceRef="N_n6" targetRef="N_n7"/>
    <bpmn:sequenceFlow id="F_e16" name="" sourceRef="N_n7" targetRef="N_n9"/>
    <bpmn:sequenceFlow id="F_e17" name="" sourceRef="N_n7" targetRef="N_n8"/>
    <bpmn:sequenceFlow id="F_e18" name="" sourceRef="N_n8" targetRef="N_n9"/>
  </bpmn:process>
