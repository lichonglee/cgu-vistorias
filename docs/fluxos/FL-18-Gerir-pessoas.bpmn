    <bpmn:sequenceFlow id="F_e19" name="Desativar" sourceRef="N_n6" targetRef="N_n7"/>
    <bpmn:sequenceFlow id="F_e20" name="Apagar" sourceRef="N_n6" targetRef="N_n8"/>
    <bpmn:sequenceFlow id="F_e21" name="" sourceRef="N_n7" targetRef="N_n12"/>
    <bpmn:sequenceFlow id="F_e22" name="" sourceRef="N_n8" targetRef="N_n9"/>
    <bpmn:sequenceFlow id="F_e23" name="Sim" sourceRef="N_n9" targetRef="N_n10"/>
    <bpmn:sequenceFlow id="F_e24" name="Não" sourceRef="N_n9" targetRef="N_n11"/>
    <bpmn:sequenceFlow id="F_e25" name="" sourceRef="N_n11" targetRef="N_n13"/>
  </bpmn:process>
