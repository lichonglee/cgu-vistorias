<?xml version="1.0" encoding="UTF-8"?>
<bpmn:definitions xmlns:bioc="http://bpmn.io/schema/bpmn/biocolor/1.0" xmlns:color="http://www.omg.org/spec/BPMN/non-normative/color/1.0" xmlns:bpmn="http://www.omg.org/spec/BPMN/20100524/MODEL" xmlns:bpmndi="http://www.omg.org/spec/BPMN/20100524/DI" xmlns:dc="http://www.omg.org/spec/DD/20100524/DC" xmlns:ipog="http://ipog.edu.br/schema" xmlns:di="http://www.omg.org/spec/DD/20100524/DI" id="Definitions_1" targetNamespace="http://ipog.edu.br/bpmn" exporter="IPOG Fluxos de Trabalho BIM" exporterVersion="2.0">
  <bpmn:process id="Process_1" name="FL-18 · Gerir pessoas" isExecutable="false">
    <bpmn:documentation>Convite, papel, vencimento, senha temporária, associação a unidades, desativação e exclusão com checagem de bloqueios.&#10;Curso: Controladoria-Geral da União · Disciplina: CGU Vistorias v1.0.5 · Autores: Responsável: Eng. DSc Li Chong Lee Bacelar de Castro · Revisão: R01</bpmn:documentation>
    <bpmn:startEvent id="N_n1" name="Nova pessoa ou mudança"><bpmn:outgoing>F_e14</bpmn:outgoing></bpmn:startEvent>
    <bpmn:task id="N_n2" name="Cadastrar ou convidar a pessoa" ipog:responsavel="Administrador"><bpmn:documentation>Responsável: Administrador</bpmn:documentation><bpmn:incoming>F_e14</bpmn:incoming><bpmn:outgoing>F_e15</bpmn:outgoing></bpmn:task>
    <bpmn:task id="N_n3" name="Definir papel e vencimento do acesso" ipog:responsavel="Administrador"><bpmn:documentation>Responsável: Administrador</bpmn:documentation><bpmn:incoming>F_e15</bpmn:incoming><bpmn:outgoing>F_e16</bpmn:outgoing></bpmn:task>
    <bpmn:task id="N_n4" name="Gerar senha temporária e enviar link por e-mail" ipog:responsavel="Central"><bpmn:documentation>Responsável: Central</bpmn:documentation><bpmn:incoming>F_e16</bpmn:incoming><bpmn:outgoing>F_e17</bpmn:outgoing></bpmn:task>
    <bpmn:task id="N_n5" name="Associar a outra unidade, se for o caso" ipog:responsavel="Administrador"><bpmn:documentation>Responsável: Administrador</bpmn:documentation><bpmn:incoming>F_e17</bpmn:incoming><bpmn:outgoing>F_e18</bpmn:outgoing></bpmn:task>
    <bpmn:exclusiveGateway id="N_n6" name="Desativar ou apagar?"><bpmn:incoming>F_e18</bpmn:incoming><bpmn:outgoing>F_e19</bpmn:outgoing><bpmn:outgoing>F_e20</bpmn:outgoing></bpmn:exclusiveGateway>
    <bpmn:task id="N_n7" name="Desativar a conta" ipog:responsavel="Administrador"><bpmn:documentation>Responsável: Administrador</bpmn:documentation><bpmn:incoming>F_e19</bpmn:incoming><bpmn:outgoing>F_e21</bpmn:outgoing></bpmn:task>
    <bpmn:task id="N_n8" name="Checar bloqueios (cgu_user_delete_check)" ipog:responsavel="Central"><bpmn:documentation>Responsável: Central</bpmn:documentation><bpmn:incoming>F_e20</bpmn:incoming><bpmn:outgoing>F_e22</bpmn:outgoing></bpmn:task>
    <bpmn:exclusiveGateway id="N_n9" name="Há bloqueios?"><bpmn:incoming>F_e22</bpmn:incoming><bpmn:outgoing>F_e23</bpmn:outgoing><bpmn:outgoing>F_e24</bpmn:outgoing></bpmn:exclusiveGateway>
    <bpmn:endEvent id="N_n10" name="Exclusão bloqueada"><bpmn:incoming>F_e23</bpmn:incoming></bpmn:endEvent>
    <bpmn:task id="N_n11" name="Apagar a conta" ipog:responsavel="Administrador"><bpmn:documentation>Responsável: Administrador</bpmn:documentation><bpmn:incoming>F_e24</bpmn:incoming><bpmn:outgoing>F_e25</bpmn:outgoing></bpmn:task>
    <bpmn:endEvent id="N_n12" name="Conta desativada"><bpmn:incoming>F_e21</bpmn:incoming></bpmn:endEvent>
    <bpmn:endEvent id="N_n13" name="Conta apagada"><bpmn:incoming>F_e25</bpmn:incoming></bpmn:endEvent>
    <bpmn:sequenceFlow id="F_e14" name="" sourceRef="N_n1" targetRef="N_n2"/>
    <bpmn:sequenceFlow id="F_e15" name="" sourceRef="N_n2" targetRef="N_n3"/>
