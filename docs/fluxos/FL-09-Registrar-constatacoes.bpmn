  <bpmn:process id="Process_1" name="FL-09 · Registrar as constatações" isExecutable="false">
    <bpmn:documentation>Tipo (lista por sistema), ambiente, gravidade, descrição, recomendação e fotos relacionadas.&#10;Curso: Controladoria-Geral da União · Disciplina: CGU Vistorias v1.0.5 · Autores: Responsável: Eng. DSc Li Chong Lee Bacelar de Castro · Revisão: R01</bpmn:documentation>
    <bpmn:startEvent id="N_n1" name="Aba Constatações aberta"><bpmn:outgoing>F_e12</bpmn:outgoing></bpmn:startEvent>
    <bpmn:task id="N_n2" name="Tocar em + Nova constatação" ipog:responsavel="Usuário"><bpmn:documentation>Responsável: Usuário</bpmn:documentation><bpmn:incoming>F_e12</bpmn:incoming><bpmn:incoming>F_e22</bpmn:incoming><bpmn:outgoing>F_e13</bpmn:outgoing></bpmn:task>
    <bpmn:task id="N_n3" name="Escolher o tipo na lista suspensa; o título é preenchido" ipog:responsavel="Usuário"><bpmn:documentation>Responsável: Usuário</bpmn:documentation><bpmn:incoming>F_e13</bpmn:incoming><bpmn:incoming>F_e20</bpmn:incoming><bpmn:outgoing>F_e14</bpmn:outgoing></bpmn:task>
    <bpmn:task id="N_n4" name="Escolher o ambiente e detalhar o local / elemento" ipog:responsavel="Usuário"><bpmn:documentation>Responsável: Usuário</bpmn:documentation><bpmn:incoming>F_e14</bpmn:incoming><bpmn:outgoing>F_e15</bpmn:outgoing></bpmn:task>
    <bpmn:task id="N_n5" name="Selecionar a gravidade (Informativa a Crítica)" ipog:responsavel="Usuário"><bpmn:documentation>Responsável: Usuário</bpmn:documentation><bpmn:incoming>F_e15</bpmn:incoming><bpmn:outgoing>F_e16</bpmn:outgoing></bpmn:task>
    <bpmn:task id="N_n6" name="Preencher descrição e recomendação técnicas" ipog:responsavel="Usuário"><bpmn:documentation>Responsável: Usuário</bpmn:documentation><bpmn:incoming>F_e16</bpmn:incoming><bpmn:outgoing>F_e17</bpmn:outgoing></bpmn:task>
    <bpmn:task id="N_n7" name="Marcar as fotos relacionadas (contorno de destaque)" ipog:responsavel="Usuário"><bpmn:documentation>Responsável: Usuário</bpmn:documentation><bpmn:incoming>F_e17</bpmn:incoming><bpmn:outgoing>F_e18</bpmn:outgoing></bpmn:task>
    <bpmn:exclusiveGateway id="N_n8" name="Título preenchido?"><bpmn:incoming>F_e18</bpmn:incoming><bpmn:outgoing>F_e19</bpmn:outgoing><bpmn:outgoing>F_e20</bpmn:outgoing></bpmn:exclusiveGateway>
    <bpmn:task id="N_n9" name="Tocar em Salvar" ipog:responsavel="Usuário"><bpmn:documentation>Responsável: Usuário</bpmn:documentation><bpmn:incoming>F_e19</bpmn:incoming><bpmn:outgoing>F_e21</bpmn:outgoing></bpmn:task>
    <bpmn:exclusiveGateway id="N_n10" name="Há mais achados?"><bpmn:incoming>F_e21</bpmn:incoming><bpmn:outgoing>F_e22</bpmn:outgoing><bpmn:outgoing>F_e23</bpmn:outgoing></bpmn:exclusiveGateway>
    <bpmn:endEvent id="N_n11" name="Constatações registradas"><bpmn:incoming>F_e23</bpmn:incoming></bpmn:endEvent>
