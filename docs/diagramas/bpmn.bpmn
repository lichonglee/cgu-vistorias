<?xml version="1.0" encoding="UTF-8"?>
<definitions xmlns="http://www.omg.org/spec/BPMN/20100524/MODEL" xmlns:bpmndi="http://www.omg.org/spec/BPMN/20100524/DI" xmlns:dc="http://www.omg.org/spec/DD/20100524/DC" xmlns:di="http://www.omg.org/spec/DD/20100524/DI" id="Defs_CGU_Vistorias" targetNamespace="https://lichonglee.github.io/cgu-vistorias/bpmn">
  <process id="ProcessoVistoria" name="Executar vistoria e emitir documento" isExecutable="false">
    <laneSet id="LaneSet_1"><lane id="Lane_Usuario" name="Usuário"><flowNodeRef>Start</flowNodeRef><flowNodeRef>Preparar</flowNodeRef><flowNodeRef>EdificioExiste</flowNodeRef><flowNodeRef>CadastrarEdificio</flowNodeRef><flowNodeRef>CriarVistoria</flowNodeRef><flowNodeRef>PreencherDados</flowNodeRef><flowNodeRef>RegistrarEvidencias</flowNodeRef><flowNodeRef>VistoriaCompleta</flowNodeRef><flowNodeRef>CompletarDados</flowNodeRef><flowNodeRef>RegistrarConstatacoes</flowNodeRef><flowNodeRef>RevisarConclusao</flowNodeRef><flowNodeRef>TipoDocumento</flowNodeRef><flowNodeRef>RascunhoOficial</flowNodeRef><flowNodeRef>SequenciaExiste</flowNodeRef><flowNodeRef>ReservarNumero</flowNodeRef><flowNodeRef>GerarArquivo</flowNodeRef><flowNodeRef>RegistrarEmissao</flowNodeRef><flowNodeRef>ExportarBackup</flowNodeRef><flowNodeRef>End</flowNodeRef></lane><lane id="Lane_App" name="Aplicativo CGU Vistorias"><flowNodeRef>SalvarLocal</flowNodeRef><flowNodeRef>MontarDocumento</flowNodeRef><flowNodeRef>BaixarArquivo</flowNodeRef><flowNodeRef>PersistirHistorico</flowNodeRef><flowNodeRef>BackupLocal</flowNodeRef></lane></laneSet>
    <startEvent id="Start" name="Iniciar jornada"/><userTask id="Preparar" name="Configurar unidade e responsável"/><exclusiveGateway id="EdificioExiste" name="Edifício já cadastrado?"/><userTask id="CadastrarEdificio" name="Cadastrar edifício e local"/><userTask id="CriarVistoria" name="Criar vistoria"/><userTask id="PreencherDados" name="Preencher dados, objetivo e metodologia"/><userTask id="RegistrarEvidencias" name="Registrar fotos e localização (opcional)"/><serviceTask id="SalvarLocal" name="Salvar registros no IndexedDB do dispositivo"/><exclusiveGateway id="VistoriaCompleta" name="Dados suficientes para emitir?"/><userTask id="CompletarDados" name="Completar ou corrigir dados"/><userTask id="RegistrarConstatacoes" name="Registrar constatações e associar fotos"/><userTask id="RevisarConclusao" name="Revisar conclusão e recomendações"/><exclusiveGateway id="TipoDocumento" name="Escolher documento"/><userTask id="RascunhoOficial" name="Definir emissão como rascunho ou oficial"/><exclusiveGateway id="SequenciaExiste" name="Número anual já iniciado neste aparelho?"/><serviceTask id="ReservarNumero" name="Avançar sequência local e revisão"/><serviceTask id="MontarDocumento" name="Montar relatório com identidade CGU"/><serviceTask id="GerarArquivo" name="Gerar DOCX ou PDF"/><serviceTask id="BaixarArquivo" name="Disponibilizar arquivo para download"/><serviceTask id="PersistirHistorico" name="Registrar tipo, número, revisão e data"/><userTask id="ExportarBackup" name="Exportar backup JSON (opcional)"/><serviceTask id="BackupLocal" name="Empacotar dados e fotos para backup"/><endEvent id="End" name="Documento emitido e salvo"/>
    <sequenceFlow id="f1" sourceRef="Start" targetRef="Preparar"/><sequenceFlow id="f2" sourceRef="Preparar" targetRef="EdificioExiste"/><sequenceFlow id="f3" sourceRef="EdificioExiste" targetRef="CriarVistoria" name="Sim"/><sequenceFlow id="f4" sourceRef="EdificioExiste" targetRef="CadastrarEdificio" name="Não"/><sequenceFlow id="f5" sourceRef="CadastrarEdificio" targetRef="SalvarLocal"/><sequenceFlow id="f6" sourceRef="SalvarLocal" targetRef="CriarVistoria"/><sequenceFlow id="f7" sourceRef="CriarVistoria" targetRef="PreencherDados"/><sequenceFlow id="f8" sourceRef="PreencherDados" targetRef="RegistrarEvidencias"/><sequenceFlow id="f9" sourceRef="RegistrarEvidencias" targetRef="SalvarLocal"/><sequenceFlow id="f10" sourceRef="SalvarLocal" targetRef="VistoriaCompleta"/><sequenceFlow id="f11" sourceRef="VistoriaCompleta" targetRef="RegistrarConstatacoes" name="Sim"/><sequenceFlow id="f12" sourceRef="VistoriaCompleta" targetRef="CompletarDados" name="Não"/><sequenceFlow id="f13" sourceRef="CompletarDados" targetRef="PreencherDados"/><sequenceFlow id="f14" sourceRef="RegistrarConstatacoes" targetRef="RevisarConclusao"/><sequenceFlow id="f15" sourceRef="RevisarConclusao" targetRef="TipoDocumento"/><sequenceFlow id="f16" sourceRef="TipoDocumento" targetRef="RascunhoOficial" name="VT / MF / RC"/><sequenceFlow id="f17" sourceRef="RascunhoOficial" targetRef="SequenciaExiste"/><sequenceFlow id="f18" sourceRef="SequenciaExiste" targetRef="ReservarNumero" name="Sim / oficial"/><sequenceFlow id="f19" sourceRef="SequenciaExiste" targetRef="MontarDocumento" name="Rascunho"/><sequenceFlow id="f20" sourceRef="ReservarNumero" targetRef="MontarDocumento"/><sequenceFlow id="f21" sourceRef="MontarDocumento" targetRef="GerarArquivo"/><sequenceFlow id="f22" sourceRef="GerarArquivo" targetRef="BaixarArquivo"/><sequenceFlow id="f23" sourceRef="BaixarArquivo" targetRef="PersistirHistorico"/><sequenceFlow id="f24" sourceRef="PersistirHistorico" targetRef="ExportarBackup"/><sequenceFlow id="f25" sourceRef="ExportarBackup" targetRef="BackupLocal" name="Sim"/><sequenceFlow id="f26" sourceRef="ExportarBackup" targetRef="End" name="Não"/><sequenceFlow id="f27" sourceRef="BackupLocal" targetRef="End"/>
  </process>
</definitions>
